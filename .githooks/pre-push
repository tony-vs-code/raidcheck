#!/usr/bin/env bash
set -euo pipefail

# Read push info from stdin (local_ref local_sha remote_ref remote_sha)
PUSHING_TO_MAIN=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        PUSHING_TO_MAIN=1
    fi
done

if [ "$PUSHING_TO_MAIN" -eq 1 ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "ERROR: Direct pushes to 'main' are blocked by CI/CD safety policy." >&2
    echo "Please push to a feature or release branch and create a Pull Request:" >&2
    echo "  git checkout -b feat/your-feature-name" >&2
    echo "  git push -u origin feat/your-feature-name" >&2
    echo "(To bypass this guard for authorized releases, set ALLOW_MAIN_PUSH=1)" >&2
    exit 1
fi

echo "==> [pre-push hook] Running pytest quality gate..."
if command -v uv >/dev/null 2>&1; then
    uv run pytest -v
else
    pytest -v
fi

echo "==> [pre-push hook] Quality gate passed."
exit 0
